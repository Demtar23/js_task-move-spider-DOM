'use strict';
var wall = document.querySelector('.wall');
var spider = document.querySelector('.spider');
wall.addEventListener('click', function(e) {
    var wallRect = wall.getBoundingClientRect();
    var centerX = e.clientX - wallRect.left - wall.clientLeft - spider.offsetWidth / 2;
    var centerY = e.clientY - wallRect.top - wall.clientTop - spider.offsetHeight / 2;
    if (centerX < 0) centerX = 0;
    if (centerY < 0) centerY = 0;
    var maxX = wall.clientWidth - spider.offsetWidth;
    var maxY = wall.clientHeight - spider.offsetHeight;
    if (centerX > maxX) centerX = maxX;
    if (centerY > maxY) centerY = maxY;
    spider.style.left = centerX + 'px';
    spider.style.top = centerY + 'px';
});

